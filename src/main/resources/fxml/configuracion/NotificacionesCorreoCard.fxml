<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<AnchorPane fx:id="root" xmlns:fx="http://javafx.com/fxml" fx:controller="com.farmaciavictoria.proyectopharmavictoria.controller.configuracion.NotificacionesCorreoCardController" prefWidth="280" prefHeight="180" styleClass="pv-tarjeta, pv-tarjeta-verde">
    <children>
        <ImageView fx:id="imgIcono" layoutX="110" layoutY="18" fitWidth="60" fitHeight="60" preserveRatio="true">
            <image>
                <Image url="@/icons/emailnotificacion.png" />
            </image>
        </ImageView>
        <Label fx:id="lblTitulo" text="Notificaciones por Correo" layoutX="16" layoutY="90" styleClass="pv-tarjeta-titulo" />
        <Label fx:id="lblDetalle" text="Configurar envío de alertas" layoutX="16" layoutY="140" styleClass="pv-tarjeta-detalle" />
    </children>
</AnchorPane>
