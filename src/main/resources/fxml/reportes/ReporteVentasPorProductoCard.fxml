    <children>
        <ImageView fx:id="imgIcono" layoutX="110" layoutY="18" fitWidth="60" fitHeight="60" preserveRatio="true">
            <image>
                <Image url="@/icons/productosreporte.png" />
            </image>
        </ImageView>
        <Label fx:id="lblTitulo" text="Ventas por Producto" layoutX="16" layoutY="90" styleClass="pv-tarjeta-titulo" />
        <Label fx:id="lblDetalle" text="Ver ranking" layoutX="16" layoutY="140" styleClass="pv-tarjeta-detalle" />
    </children>
</AnchorPane>
